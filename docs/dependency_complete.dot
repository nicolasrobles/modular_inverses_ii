digraph dependencies {
  graph [
    rankdir="TB",
    bgcolor="white",
    pad="0.3",
    nodesep="0.25",
    ranksep="0.62",
    splines="spline",
    outputorder="edgesfirst",
    fontname="DejaVu Sans",
    fontsize="17",
    fontcolor="#0F172A",
    labelloc="t",
    label="Complete documented dependencies · v17\nNumbered statements, supporting steps, and literature inputs\nPurple: trusted references; green: certified; yellow: pending certification",
  ];
  edge [color="#4b5563", arrowsize="0.65", penwidth="1.0", fontname="DejaVu Sans", fontsize="9"];
  "thm:height" [label="Theorem 1.1\nCumulative height mean\n[Pending]", tooltip="For real $N,X\\ge1$, the height average of the second moment over $N\\le\\lvert n\\rvert<2N$ is $\\ll_\\varepsilon (NX)^\\varepsilon NX^2$. Both frequency signs are included.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#thm-height", target="_top"];
  "thm:short" [label="Theorem 1.2\nMoving intervals\n[Pending]", tooltip="For $N,X\\ge1$ and $0<\\delta\\le1$, restricting the moduli to $(Y,(1+\\delta)Y]$ gives the height-mean bound $\\ll_\\varepsilon (NX)^\\varepsilon X^2\\{N\\delta+\\min(1,N\\delta^2X)\\}$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#thm-short", target="_top"];
  "cor:most" [label="Corollary 1.3\nExceptional heights\n[Pending]", tooltip="For $a,\\kappa,\\eta>0$ and $X\\ge2$, outside a set of Lebesgue measure $O_{a,\\kappa,\\eta}(X^{1-\\kappa+\\eta})$, the bound $\\mathcal K_2(N;Y)\\le3NX^{2+\\kappa}$ holds simultaneously for every real $1\\le N\\le X^a$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#cor-most", target="_top"];
  "thm:pair-height" [label="Theorem 1.4\nPair-difference discrepancy\n[Pending]", tooltip="For $X\\ge2$, the height average of $\\mathcal D_Y+\\mathcal D_Y^*$ is $\\ll_\\varepsilon X^{-2+\\varepsilon}$. Each discrepancy is at least $\\lfloor Y\\rfloor^{-2}$ for every $Y\\ge2$. The supremum over rectangles is inside the average.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#thm-pair-height", target="_top"];
  "cor:pair-height-most" [label="Corollary 1.5\nExceptional discrepancy heights\n[Pending]", tooltip="For $\\kappa,\\eta>0$ and $X\\ge2$, both discrepancies are at most $X^{-2+\\kappa}$ outside a set of Lebesgue measure $O_{\\kappa,\\eta}(X^{1-\\kappa+\\eta})$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#cor-pair-height-most", target="_top"];
  "thm:distance" [label="Theorem 1.6\nDistance moments\nand covering radius\n[Pending]", tooltip="For $X\\ge2$, the positive distance moments have orders $X^{-s}$ for $0<s<2$, $X^{-2}(\\log X)^2$ for $s=2$, and $X^{-1-s/2}$ for $s>2$. The covering radius lies between $\\tfrac12X^{-1/2}$ and $4X^{-1/2}$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#thm-distance", target="_top"];
  "thm:correction" [label="Theorem 1.7\nPositive weighted\nFarey correction\n[Pending]", tooltip="For integer $Q\\ge2$, $1/2\\le\\tau<1$ and $L=\\tau Q^2$, an exact sinc-squared weighted second moment isolates determinant-one Farey pairs. Its asymptotic is $LN_Q+(12\\tau/\\pi^2)I(\\tau)Q^4+O(Q^3\\log(2Q))$, uniformly in $\\tau$, with $I(\\tau)>0$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#thm-correction", target="_top"];
  "cor:obstruction" [label="Corollary 1.8\nSharp interval obstruction\n[Pending]", tooltip="For every sufficiently large integer $Q$, some symmetric interval with radius $T\\asymp Q^2$ has a second-moment remainder whose absolute value is $\\gg Q^4$. The constants are absolute; this is an existence statement for the interval.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#cor-obstruction", target="_top"];
  "lem:kuznetsov" [label="Lemma 2.1\nKuznetsov and\nspectral large sieve\n[Pending]", tooltip="Records the inverse Kuznetsov formula for both signs and the local spectral large sieve on a window of width $G$, for $N,T\\ge1$ and $1\\le G\\le T$. The formula uses the signed measure $dm=\\chi\\,dm_0$; the large sieve uses positive $dm_0$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-kuznetsov", target="_top"];
  "lem:window" [label="Lemma 2.2\nDual spectral windows\n[Pending]", tooltip="Deduces a dual second-moment estimate $\\ll_\\eta F^2TG(TG+N)^{1+\\eta}$ for a spectral-window integral with a multiplier bounded by $F$, for either sign.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-window", target="_top"];
  "lem:transforms" [label="Lemma 2.3\nHigh and holomorphic\nBessel transforms\n[Pending]", tooltip="Records the uniform-in-$r$ twisted Bessel estimates in the imaginary range $\\lvert t\\rvert\\ge1$ and the holomorphic range $k\\ge1$. The low imaginary spectrum is treated separately in Lemma 2.4.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-transforms", target="_top"];
  "lem:low" [label="Lemma 2.4\nLow-spectrum transform\n[Pending]", tooltip="For $\\lvert t\\rvert\\le1$ and $Z>0$, both twisted transforms are $\\ll_V1+\\log^+(1/Z)$, uniformly in the real twist $r$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-low", target="_top"];
  "lem:weil" [label="Lemma 2.5\nWeil bound\n[Pending]", tooltip="For all integer $m,n$ and $c\\ge1$, $\\lvert S(m,n;c)\\rvert\\le(m,n,c)^{1/2}c^{1/2}\\tau(c)$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-weil", target="_top"];
  "lem:selberg" [label="Lemma 2.6\nSelberg identity\n[Pending]", tooltip="Expresses $S(m,n;c)$, for integer arguments, as a divisor sum of Kloosterman sums with one argument equal to one. The cumulative form is equation (2.6).", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-selberg", target="_top"];
  "lem:farey" [label="Lemma 2.7\nFarey adjacency\n[Pending]", tooltip="Consecutive fractions of Farey order $Q\\ge1$ have determinant one and denominators whose sum exceeds $Q$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-farey", target="_top"];
  "lem:sieve" [label="Lemma 2.8\nTwo-sided large sieve\n[Pending]", tooltip="For frequencies separated by $\\lambda$ modulo one and any integer interval of length $H\\ge1$, the absolute error from $H\\sum_j\\lvert y_j\\rvert^2$ is at most $\\lambda^{-1}\\sum_j\\lvert y_j\\rvert^2$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-sieve", target="_top"];
  "lem:ks" [label="Lemma 2.9\nKoksma-Szusz\nwith repetitions\n[Pending]", tooltip="Bounds rectangular discrepancy of a nonempty finite sequence in $\\mathbb T^2$ by a Fourier sum and a truncation term, allowing repeated points and closed or half-open arcs, including empty and full arcs.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-ks", target="_top"];
  "lem:twist" [label="Lemma 3.1\nTwisted second moment\n[Pending]", tooltip="For a fixed smooth compactly supported $W$, $C,N\\ge1$ and real $r$, the second moment of the twisted smooth sums $B_\\sigma(n,r)$ is $\\ll_{\\varepsilon,W}(NC(1+\\lvert r\\rvert))^\\varepsilon(N+1+\\lvert r\\rvert)$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-twist", target="_top"];
  "lem:annulus" [label="Lemma 3.2\nMoving-annulus mean\n[Pending]", tooltip="Proves the moving-interval height mean at a base height $C\\ge1$, with the factor $N\\delta+\\min(1,N\\delta^2C)$. Theorem 1.2 is the corresponding formulation with signed frequencies.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-annulus", target="_top"];
  "cor:weighted" [label="Corollary 3.3\nWeighted height mean\n[Pending]", tooltip="For $N,X\\ge1$, inserting the weight $1/c$ in the cumulative sums gives height-averaged second moment $\\ll_\\varepsilon(NX)^\\varepsilon N$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#cor-weighted", target="_top"];
  "prop:two" [label="Proposition 3.4\nTwo-frequency height mean\n[Pending]", tooltip="For $M,N,X\\ge1$, the height-averaged second moment over $\\lvert m\\rvert\\le M$, $\\lvert n\\rvert\\le N$, excluding $(0,0)$, is $\\ll_\\varepsilon(MNX)^\\varepsilon MNX^2$. Both coordinate axes are included.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#prop-two", target="_top"];
  "rem:weighted-two" [label="Remark 3.5\nWeighted two-frequency mean\n[Pending]", tooltip="With the weight $1/c$, the same frequency rectangle has height-averaged second moment $\\ll_\\varepsilon(MNX)^\\varepsilon MN$. The proof of Corollary 3.3 is reused with Proposition 3.4 as the input estimate.", shape="box", style="rounded,dashed,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#rem-weighted-two", target="_top"];
  "lem:pair-pointwise" [label="Lemma 4.1\nFourier discrepancy bound\n[Pending]", tooltip="For $Y\\ge2$ and integer $K\\ge1$, controls $\\mathcal D_Y$ by weighted squared Fourier coefficients and $1/K$, and proves $\\mathcal D_Y^*\\le\\mathcal D_Y+1/N_Y$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-pair-pointwise", target="_top"];
  "lem:farey-product" [label="Lemma 5.1\nPoints in Farey products\n[Pending]", tooltip="If integers $Q,R\\ge1$ satisfy $2QR\\le X$, every product of open consecutive Farey gaps of orders $Q$ and $R$ contains a lift of a point of $\\mathcal P_X$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-farey-product", target="_top"];
  "lem:adaptive" [label="Lemma 5.2\nAdaptive Farey orders\n[Pending]", tooltip="For $0<\\rho\\le1$ and irrational $x$, controls the least Farey order $R_\\rho(x)$ giving a gap of length at most $\\rho$. It proves the range $\\rho^{-1/2}\\le R_\\rho(x)\\le2/\\rho$ and a quadratic tail estimate.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-adaptive", target="_top"];
  "lem:product-tail" [label="Lemma 5.3\nProduct tail\n[Pending]", tooltip="Bounds the tail of $\\rho R_\\rho(x)R_\\rho(y)$ by a quadratic decay times the smaller of two logarithmic factors, for $1\\le z\\le4/\\rho$; above this range the tail is empty on irrational-coordinate pairs.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-product-tail", target="_top"];
  "lem:distance-tail" [label="Lemma 5.4\nDistance tail\n[Pending]", tooltip="For $X\\ge2$ and $t>0$, the measure of $\\{d_X>t\\}$ is $\\ll [1+\\min\\{\\log(2+Xt),\\log(2+1/(Xt^2))\\}]/(X^2t^2)$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-distance-tail", target="_top"];
  "lem:empty" [label="Lemma 5.5\nEmpty rectangles\n[Pending]", tooltip="Gives an explicit arithmetic inequality in the denominators of the rational corner and the side lengths that makes two oppositely oriented open rectangles empty of lifts of $\\mathcal P_X$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-empty", target="_top"];
  "rem:negative" [label="Remark 5.6\nNegative distance moments\n[Pending]", tooltip="For $X\\ge2$ and $-2<s<0$, the distance moment has order $X^{-s}$. For $s\\le-2$ it diverges. The three assertions use disc counting, the positive first-moment upper bound, and a local singularity, respectively.", shape="box", style="rounded,dashed,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#rem-negative", target="_top"];
  "prop:long" [label="Proposition 6.1\nLong-interval remainder\n[Pending]", tooltip="For integer $Q\\ge2$, $M\\in\\mathbb Z$ and integer $H\\ge1$, the second moment over $M<n\\le M+H$ differs from $HN_Q$ by at most $Q(Q-1)N_Q$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#prop-long", target="_top"];
  "lem:poisson" [label="Lemma 6.2\nPoisson weight identity\n[Pending]", tooltip="For real $L\\ge2$, the absolutely convergent Fourier series of $w(n/L)$ equals the triangular kernel $L(1-L\\lVert\\theta\\rVert)_+$ for every real $\\theta$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-poisson", target="_top"];
  "lem:exact" [label="Lemma 6.3\nExact weighted identity\n[Pending]", tooltip="For integer $Q\\ge2$ and real $L\\ge Q^2/2$, evaluates the weighted second moment as the diagonal term $LN_Q$ plus the contribution of determinant-one Farey pairs. The correction vanishes for $L\\ge Q(Q-1)$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-exact", target="_top"];
  "lem:positive" [label="Lemma 6.4\nPositivity of I(tau)\n[Pending]", tooltip="For $1/2\\le\\tau<1$, reduces $I(\\tau)$ to a one-dimensional integral and proves it is positive. On $[1/2,5/8]$ it gives the explicit lower bound $1/9000$.", shape="box", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-positive", target="_top"];
  "step:low-kernel-integrals" [label="Low-spectrum\nkernel integrals", tooltip="Bounds the Schlaefli remainder integral and both low-spectrum kernels by $1+\\log^+(1/x)$, then integrates over the fixed scaled support.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#step-low-kernel-integrals", target="_top"];
  "eq:symmetries" [label="Kloosterman symmetries (2.5)", tooltip="Records reality, interchange of the two arguments, and simultaneous sign reversal of Kloosterman sums. In particular, $S(-n,1;c)=S(n,-1;c)$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#eq-symmetries", target="_top"];
  "step:divisor-small-power" [label="Divisor bound", tooltip="Uses $\\tau(n)\\ll_\\eta n^\\eta$ for every $\\eta>0$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#step-divisor-small-power", target="_top"];
  "eq:selberg-sum" [label="Cumulative Selberg\nidentity (2.6)", tooltip="Sums Selberg's identity over the modulus to reduce $A_Y(m,n)$ to divisor-weighted sums $A_{Y/d}(mn/d^2,1)$ for $mn\\ne0$. Terms with $d>Y$ vanish.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#eq-selberg-sum", target="_top"];
  "eq:axes" [label="Coordinate-axis bound (2.7)", tooltip="The Ramanujan-sum formula gives $\\lvert A_Y(0,n)\\rvert\\le Y\\tau(\\lvert n\\rvert)$ for $n\\ne0$. Interchange of arguments covers the other axis.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#eq-axes", target="_top"];
  "eq:farey-gap" [label="Farey gap lengths (2.8)", tooltip="The length of an adjacent Farey gap is $1/(qq')$ and lies between $Q^{-2}$ and $Q^{-1}$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#eq-farey-gap", target="_top"];
  "step:farey-nesting" [label="Farey nesting", tooltip="Increasing the Farey order adds fractions, so every new gap is contained in an old gap.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#step-farey-nesting", target="_top"];
  "eq:farey-separation" [label="Circular separation (2.9)", tooltip="Distinct reduced fractions modulo one, with denominators at most $Q\\ge2$, are separated by at least $1/[Q(Q-1)]$. The proof uses denominator arithmetic directly.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#eq-farey-separation", target="_top"];
  "step:large-sieve-endpoint-sums" [label="Large-sieve endpoint sums", tooltip="Writes the off-diagonal interval sum as a difference of two cosecant bilinear forms and bounds each by the Montgomery-Vaughan inequality.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#step-large-sieve-endpoint-sums", target="_top"];
  "step:ks-repetition-and-arcs" [label="Repetitions and arcs", tooltip="Perturbs repeated points to distinct points and passes to limits. Monotone approximation then covers the stated arc conventions and degeneracies.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#step-ks-repetition-and-arcs", target="_top"];
  "step:twisted-spectral-decomposition" [label="Twisted spectral decomposition", tooltip="Applies Kuznetsov with a scalar of modulus one, separates low, holomorphic, and higher imaginary spectral ranges, and sums the window estimates by Minkowski.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#step-twisted-spectral-decomposition", target="_top"];
  "eq:elementary" [label="Elementary annulus bound", tooltip="Counts the moduli in a moving interval and the logarithmic height measure contributed by each modulus; the Weil and divisor bounds give the elementary mean-square estimate.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#eq-elementary", target="_top"];
  "eq:mellin" [label="Mellin decay of the cutoff", tooltip="Constructs a smooth approximation to the moving interval and bounds its Mellin transform in terms of the interval length and the smoothing width.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#eq-mellin", target="_top"];
  "eq:plancherel" [label="Height Plancherel identity", tooltip="The substitution $Y=C\\exp(u)$ converts the height mean of the smooth sums to a Fourier Plancherel integral in the twist parameter.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#eq-plancherel", target="_top"];
  "eq:smooth-bound" [label="Smooth height mean", tooltip="Combines the twisted second moment, Mellin decay, and Plancherel to bound the smoothed height mean.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#eq-smooth-bound", target="_top"];
  "step:remove-annular-weights" [label="Remove smoothing;\ncombine the two bounds", tooltip="The smoothing changes at most two boundary moduli on the relevant height block. Bounds this error by Weil, then combines the spectral and elementary estimates to obtain the minimum in Lemma 3.2.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#step-remove-annular-weights", target="_top"];
  "step:cumulative-dyadic-height" [label="Dyadic cumulative sum", tooltip="Decomposes the cumulative modulus sum into dyadic annuli and uses Minkowski. At most two contributing blocks lie below base height one; these are treated directly.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#step-cumulative-dyadic-height", target="_top"];
  "step:exceptional-real-cutoffs" [label="Uniform exceptional set", tooltip="Applies Chebyshev on finitely many dyadic frequency blocks and covers each real interval $[N,2N)$ by two adjacent blocks. Their lengths sum to at most $3N$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#step-exceptional-real-cutoffs", target="_top"];
  "step:vector-Abel-summation" [label="Vector partial summation", tooltip="Applies partial summation coordinatewise and Minkowski to a finite vector of frequencies. An unweighted height mean then supplies the corresponding mean with weight $1/c$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#step-vector-Abel-summation", target="_top"];
  "step:two-frequency-reduction" [label="Two-frequency reduction", tooltip="Uses cumulative Selberg, Cauchy-Schwarz, and divisor counting to apply Theorem 1.1. Treats base heights below one directly and handles the coordinate axes separately.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#step-two-frequency-reduction", target="_top"];
  "geom:difference-fourier" [label="Fourier coefficients\nof differences", tooltip="The normalized Fourier coefficient of the multiset of ordered differences is the squared absolute value of the coefficient of the original point set.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#geom-difference-fourier", target="_top"];
  "geom:diagonal-removal" [label="Remove diagonal pairs", tooltip="Splits the difference measure into distinct pairs and a mass $1/N_Y$ at zero. The resulting discrepancy change is at most $1/N_Y$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#geom-diagonal-removal", target="_top"];
  "eq:pair-block" [label="Discrepancy blocks (4.3)", tooltip="Uses Proposition 3.4 and the cardinality comparison to bound each weighted dyadic frequency block. The blocks on the axes are retained; the origin is excluded.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#eq-pair-block", target="_top"];
  "geom:pair-upper" [label="Upper discrepancy bound", tooltip="Sums the frequency blocks, applies Lemma 4.1, and chooses the Fourier cutoff of order $X^2$ to prove the upper discrepancy bound.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#geom-pair-upper", target="_top"];
  "geom:first-coordinate-injectivity" [label="Reduced-fraction\nprojection", tooltip="The first coordinate determines the reduced denominator and then its unique modular inverse. Thus distinct points have distinct first coordinates, including the modulus-one origin.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#geom-first-coordinate-injectivity", target="_top"];
  "geom:pair-lower" [label="Empty-strip lower bound", tooltip="Circular separation gives a strip containing no differences, including no diagonal difference. Letting its left endpoint approach zero gives the lower discrepancy bound.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#geom-pair-lower", target="_top"];
  "geom:covering-upper" [label="Covering upper bound", tooltip="Takes $Q=\\lfloor\\sqrt{X/2}\\rfloor$ and uses a point in every product of Farey gaps to obtain the upper covering bound, including rational endpoints by closure.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#geom-covering-upper", target="_top"];
  "eq:gap-monotone" [label="Gap bounds and nesting (5.1)", tooltip="Combines the Farey gap bounds with nesting and defines the least order at which the gap containing an irrational coordinate is short enough.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#eq-gap-monotone", target="_top"];
  "eq:layer-cake" [label="Layer-cake identity (5.6)", tooltip="Expresses a positive distance moment as the integral of its tail by Tonelli's theorem.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#eq-layer-cake", target="_top"];
  "geom:positive-moment-upper" [label="Positive moment upper bounds", tooltip="Integrates the distance-tail estimate in the three ranges of $s$, using the already proved upper covering bound for the support cutoff.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#geom-positive-moment-upper", target="_top"];
  "eq:counting-lower" [label="Disc-counting lower bound (5.8)", tooltip="The union of small discs around the $N_X$ points covers at most half the torus. This gives a lower moment bound of order $X^{-s}$ for every fixed $s>0$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#eq-counting-lower", target="_top"];
  "eq:square-integral" [label="Empty-square integral (5.9)", tooltip="On an empty square, the distance to the point set is at least the distance to the boundary. Integrates this boundary distance explicitly.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#eq-square-integral", target="_top"];
  "geom:supercritical-lower" [label="Supercritical lower bound", tooltip="One empty square of side $1/(2\\sqrt X)$ gives the lower moment bound of order $X^{-1-s/2}$ for $s>2$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#geom-supercritical-lower", target="_top"];
  "eq:distance-lower" [label="Critical square packing (5.10)", tooltip="Packs disjoint empty squares near rational pairs with small denominators. Their contributions produce the square of a harmonic totient sum.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#eq-distance-lower", target="_top"];
  "geom:totient-harmonic" [label="Harmonic totient sum", tooltip="Derives $\\sum_{q\\le y}\\varphi(q)/q^2=(6/\\pi^2)\\log y+O(1)$ by the elementary Mobius formula and a harmonic-sum estimate.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#geom-totient-harmonic", target="_top"];
  "geom:critical-lower" [label="Critical moment lower bound", tooltip="Combines the disjoint-square packing with the totient sum to obtain the critical $X^{-2}(\\log X)^2$ lower bound. The counting bound covers the remaining bounded range of heights.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#geom-critical-lower", target="_top"];
  "geom:empty-tangent-disc" [label="Tangent-disc covering\nlower bound", tooltip="Proves directly that a disc tangent at the origin contains no lift of the point set. This gives the lower covering bound independently of the empty-rectangle lemma.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#geom-empty-tangent-disc", target="_top"];
  "geom:negative-upper" [label="Negative moment upper bound", tooltip="Disc counting and the layer-cake identity for negative powers establish finiteness and the upper bound for $-2<s<0$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#geom-negative-upper", target="_top"];
  "geom:negative-lower" [label="Negative moment lower bound", tooltip="Jensen's inequality and only the upper first-moment estimate in Theorem 1.6 give the lower bound for negative moments.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#geom-negative-lower", target="_top"];
  "geom:negative-divergence" [label="Divergence at s <= -2", tooltip="The origin belongs to the point set, so a local polar integral proves divergence for $s\\le-2$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#geom-negative-divergence", target="_top"];
  "support:cardinality-comparison" [label="Cardinality comparison", tooltip="The summatory totient estimate gives $N_X=(3/\\pi^2)X^2+O(X\\log(2X))$, hence $N_Y\\asymp X^2$ for $X\\le Y\\le2X$. The discrepancy proof needs the lower bound for normalization.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#support-cardinality-comparison", target="_top"];
  "support:cardinality-upper" [label="Elementary cardinality bound", tooltip="The identity $N_X=\\sum_{c\\le X}\\varphi(c)$ and $\\varphi(c)\\le c$ give $N_X\\le X^2$ for $X\\ge1$. This is sufficient for the distance counting arguments and the interval remainder bound.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#support-cardinality-upper", target="_top"];
  "step:long-trig-polynomial" [label="Farey polynomial (6.1)", tooltip="Opens the Kloosterman sums to express $A_Q(n,1)$ using the $N_Q$ distinct reduced fractions as frequencies and inverse phases of modulus one as coefficients.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#step-long-trig-polynomial", target="_top"];
  "step:determinant-one-pairs" [label="Determinant-one pairs", tooltip="Compact support restricts the centered determinant residue to $+1$ or $-1$. The Chinese remainder theorem counts the pairs; their conjugate inverse phases give the cosine correction.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#step-determinant-one-pairs", target="_top"];
  "step:coprime-lattice-sum" [label="Coprime lattice sum", tooltip="A uniform Lipschitz bound permits a Riemann-sum comparison on each sublattice. Mobius inversion produces the coprime main term and the $O(Q\\log(2Q))$ error before multiplication by $2L$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#step-coprime-lattice-sum", target="_top"];
  "step:abel-variation-localization" [label="Abel summation and\nvariation localization", tooltip="Combines the uniform sharp-interval remainder bound with the positive weighted correction. Abel summation and small variation near zero and in the far tail force a large remainder at radius comparable to $Q^2$.", shape="ellipse", style="rounded,filled", fillcolor="#fff4dc", color="#b88023", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#step-abel-variation-localization", target="_top"];
  "external:brs-spectral" [label="BRS, Lemma 4.3", tooltip="Kuznetsov formula and local spectral large sieve; BRS, Lemma 4.3.", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#external-brs-spectral", target="_top"];
  "external:brs-transforms" [label="BRS, Lemma 4.2", tooltip="Twisted Bessel transform estimates; BRS, Lemma 4.2.", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#external-brs-transforms", target="_top"];
  "external:brs-discrepancy" [label="BRS, Lemma 2.1", tooltip="Koksma-Szusz base inequality; BRS, Lemma 2.1.", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#external-brs-discrepancy", target="_top"];
  "external:dlmf" [label="DLMF, 10.9.6 and 10.32.9", tooltip="Integral representations of J and K Bessel functions; DLMF, Equations (10.9.6) and (10.32.9).", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#external-dlmf", target="_top"];
  "external:weil" [label="Iwaniec-Kowalski\nCorollary 11.12", tooltip="Weil bound; IK, Corollary 11.12.", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#external-weil", target="_top"];
  "external:divisor" [label="Iwaniec-Kowalski (1.81)", tooltip="Divisor small-power bound; IK, Equation (1.81).", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#external-divisor", target="_top"];
  "external:selberg" [label="Xi (1.1)", tooltip="Selberg identity for integer arguments; Xi, Equation (1.1).", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#external-selberg", target="_top"];
  "external:farey" [label="Hardy-Wright\nTheorems 28 and 30", tooltip="Adjacent Farey fractions; HW, Theorems 28 and 30.", shape="hexagon", style="rounded,filled", fillcolor="#eeeafd", color="#7762b4", fontcolor="#1f2937", fontname="DejaVu Sans", fontsize="10", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#external-farey", target="_top"];
