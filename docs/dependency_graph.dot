digraph dependencies {
  graph [
    rankdir="TB",
    bgcolor="white",
    pad="0.3",
    nodesep="0.25",
    ranksep="0.62",
    splines="spline",
    outputorder="edgesfirst",
    fontname="DejaVu Sans",
    fontsize="17",
    fontcolor="#0F172A",
    labelloc="t",
    label="Numbered statements · v17\n31 results and 2 remarks; arrows point from prerequisites to consequences",
  ];
  edge [color="#64748B", arrowsize="0.65", penwidth="1.0", fontname="DejaVu Sans", fontsize="9"];
  "thm:height" [label="Theorem 1.1\nCumulative height mean", tooltip="For real $N,X\\ge1$, the height average of the second moment over $N\\le\\lvert n\\rvert<2N$ is $\\ll_\\varepsilon (NX)^\\varepsilon NX^2$. Both frequency signs are included.", shape="box", style="rounded,filled", fillcolor="#DBEAFE", color="#2563EB", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.4", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#thm-height", target="_top"];
  "thm:short" [label="Theorem 1.2\nMoving intervals", tooltip="For $N,X\\ge1$ and $0<\\delta\\le1$, restricting the moduli to $(Y,(1+\\delta)Y]$ gives the height-mean bound $\\ll_\\varepsilon (NX)^\\varepsilon X^2\\{N\\delta+\\min(1,N\\delta^2X)\\}$.", shape="box", style="rounded,filled", fillcolor="#DBEAFE", color="#2563EB", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.4", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#thm-short", target="_top"];
  "cor:most" [label="Corollary 1.3\nExceptional heights", tooltip="For $a,\\kappa,\\eta>0$ and $X\\ge2$, outside a set of Lebesgue measure $O_{a,\\kappa,\\eta}(X^{1-\\kappa+\\eta})$, the bound $\\mathcal K_2(N;Y)\\le3NX^{2+\\kappa}$ holds simultaneously for every real $1\\le N\\le X^a$.", shape="box", style="rounded,filled", fillcolor="#EFF6FF", color="#3B82F6", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#cor-most", target="_top"];
  "thm:pair-height" [label="Theorem 1.4\nPair-difference discrepancy", tooltip="For $X\\ge2$, the height average of $\\mathcal D_Y+\\mathcal D_Y^*$ is $\\ll_\\varepsilon X^{-2+\\varepsilon}$. Each discrepancy is at least $\\lfloor Y\\rfloor^{-2}$ for every $Y\\ge2$. The supremum over rectangles is inside the average.", shape="box", style="rounded,filled", fillcolor="#DBEAFE", color="#2563EB", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.4", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#thm-pair-height", target="_top"];
  "cor:pair-height-most" [label="Corollary 1.5\nExceptional discrepancy heights", tooltip="For $\\kappa,\\eta>0$ and $X\\ge2$, both discrepancies are at most $X^{-2+\\kappa}$ outside a set of Lebesgue measure $O_{\\kappa,\\eta}(X^{1-\\kappa+\\eta})$.", shape="box", style="rounded,filled", fillcolor="#EFF6FF", color="#3B82F6", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#cor-pair-height-most", target="_top"];
  "thm:distance" [label="Theorem 1.6\nDistance moments\nand covering radius", tooltip="For $X\\ge2$, the positive distance moments have orders $X^{-s}$ for $0<s<2$, $X^{-2}(\\log X)^2$ for $s=2$, and $X^{-1-s/2}$ for $s>2$. The covering radius lies between $\\tfrac12X^{-1/2}$ and $4X^{-1/2}$.", shape="box", style="rounded,filled", fillcolor="#DBEAFE", color="#2563EB", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.4", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#thm-distance", target="_top"];
  "thm:correction" [label="Theorem 1.7\nPositive weighted\nFarey correction", tooltip="For integer $Q\\ge2$, $1/2\\le\\tau<1$ and $L=\\tau Q^2$, an exact sinc-squared weighted second moment isolates determinant-one Farey pairs. Its asymptotic is $LN_Q+(12\\tau/\\pi^2)I(\\tau)Q^4+O(Q^3\\log(2Q))$, uniformly in $\\tau$, with $I(\\tau)>0$.", shape="box", style="rounded,filled", fillcolor="#DBEAFE", color="#2563EB", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.4", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#thm-correction", target="_top"];
  "cor:obstruction" [label="Corollary 1.8\nSharp interval obstruction", tooltip="For every sufficiently large integer $Q$, some symmetric interval with radius $T\\asymp Q^2$ has a second-moment remainder whose absolute value is $\\gg Q^4$. The constants are absolute; this is an existence statement for the interval.", shape="box", style="rounded,filled", fillcolor="#EFF6FF", color="#3B82F6", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#cor-obstruction", target="_top"];
  "lem:kuznetsov" [label="Lemma 2.1\nKuznetsov and\nspectral large sieve", tooltip="Records the inverse Kuznetsov formula for both signs and the local spectral large sieve on a window of width $G$, for $N,T\\ge1$ and $1\\le G\\le T$. The formula uses the signed measure $dm=\\chi\\,dm_0$; the large sieve uses positive $dm_0$.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-kuznetsov", target="_top"];
  "lem:window" [label="Lemma 2.2\nDual spectral windows", tooltip="Deduces a dual second-moment estimate $\\ll_\\eta F^2TG(TG+N)^{1+\\eta}$ for a spectral-window integral with a multiplier bounded by $F$, for either sign.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-window", target="_top"];
  "lem:transforms" [label="Lemma 2.3\nHigh and holomorphic\nBessel transforms", tooltip="Records the uniform-in-$r$ twisted Bessel estimates in the imaginary range $\\lvert t\\rvert\\ge1$ and the holomorphic range $k\\ge1$. The low imaginary spectrum is treated separately in Lemma 2.4.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-transforms", target="_top"];
  "lem:low" [label="Lemma 2.4\nLow-spectrum transform", tooltip="For $\\lvert t\\rvert\\le1$ and $Z>0$, both twisted transforms are $\\ll_V1+\\log^+(1/Z)$, uniformly in the real twist $r$.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-low", target="_top"];
  "lem:weil" [label="Lemma 2.5\nWeil bound", tooltip="For all integer $m,n$ and $c\\ge1$, $\\lvert S(m,n;c)\\rvert\\le(m,n,c)^{1/2}c^{1/2}\\tau(c)$.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-weil", target="_top"];
  "lem:selberg" [label="Lemma 2.6\nSelberg identity", tooltip="Expresses $S(m,n;c)$, for integer arguments, as a divisor sum of Kloosterman sums with one argument equal to one. The cumulative form is equation (2.6).", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-selberg", target="_top"];
  "lem:farey" [label="Lemma 2.7\nFarey adjacency", tooltip="Consecutive fractions of Farey order $Q\\ge1$ have determinant one and denominators whose sum exceeds $Q$.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-farey", target="_top"];
  "lem:sieve" [label="Lemma 2.8\nTwo-sided large sieve", tooltip="For frequencies separated by $\\lambda$ modulo one and any integer interval of length $H\\ge1$, the absolute error from $H\\sum_j\\lvert y_j\\rvert^2$ is at most $\\lambda^{-1}\\sum_j\\lvert y_j\\rvert^2$.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-sieve", target="_top"];
  "lem:ks" [label="Lemma 2.9\nKoksma-Szusz\nwith repetitions", tooltip="Bounds rectangular discrepancy of a nonempty finite sequence in $\\mathbb T^2$ by a Fourier sum and a truncation term, allowing repeated points and closed or half-open arcs, including empty and full arcs.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-ks", target="_top"];
  "lem:twist" [label="Lemma 3.1\nTwisted second moment", tooltip="For a fixed smooth compactly supported $W$, $C,N\\ge1$ and real $r$, the second moment of the twisted smooth sums $B_\\sigma(n,r)$ is $\\ll_{\\varepsilon,W}(NC(1+\\lvert r\\rvert))^\\varepsilon(N+1+\\lvert r\\rvert)$.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-twist", target="_top"];
  "lem:annulus" [label="Lemma 3.2\nMoving-annulus mean", tooltip="Proves the moving-interval height mean at a base height $C\\ge1$, with the factor $N\\delta+\\min(1,N\\delta^2C)$. Theorem 1.2 is the corresponding formulation with signed frequencies.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-annulus", target="_top"];
  "cor:weighted" [label="Corollary 3.3\nWeighted height mean", tooltip="For $N,X\\ge1$, inserting the weight $1/c$ in the cumulative sums gives height-averaged second moment $\\ll_\\varepsilon(NX)^\\varepsilon N$.", shape="box", style="rounded,filled", fillcolor="#EFF6FF", color="#3B82F6", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#cor-weighted", target="_top"];
  "prop:two" [label="Proposition 3.4\nTwo-frequency height mean", tooltip="For $M,N,X\\ge1$, the height-averaged second moment over $\\lvert m\\rvert\\le M$, $\\lvert n\\rvert\\le N$, excluding $(0,0)$, is $\\ll_\\varepsilon(MNX)^\\varepsilon MNX^2$. Both coordinate axes are included.", shape="box", style="rounded,filled", fillcolor="#E0F2FE", color="#0284C7", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#prop-two", target="_top"];
  "rem:weighted-two" [label="Remark 3.5\nWeighted two-frequency mean", tooltip="With the weight $1/c$, the same frequency rectangle has height-averaged second moment $\\ll_\\varepsilon(MNX)^\\varepsilon MN$. The proof of Corollary 3.3 is reused with Proposition 3.4 as the input estimate.", shape="box", style="rounded,dashed,filled", fillcolor="#F1F5F9", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#rem-weighted-two", target="_top"];
  "lem:pair-pointwise" [label="Lemma 4.1\nFourier discrepancy bound", tooltip="For $Y\\ge2$ and integer $K\\ge1$, controls $\\mathcal D_Y$ by weighted squared Fourier coefficients and $1/K$, and proves $\\mathcal D_Y^*\\le\\mathcal D_Y+1/N_Y$.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-pair-pointwise", target="_top"];
  "lem:farey-product" [label="Lemma 5.1\nPoints in Farey products", tooltip="If integers $Q,R\\ge1$ satisfy $2QR\\le X$, every product of open consecutive Farey gaps of orders $Q$ and $R$ contains a lift of a point of $\\mathcal P_X$.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-farey-product", target="_top"];
  "lem:adaptive" [label="Lemma 5.2\nAdaptive Farey orders", tooltip="For $0<\\rho\\le1$ and irrational $x$, controls the least Farey order $R_\\rho(x)$ giving a gap of length at most $\\rho$. It proves the range $\\rho^{-1/2}\\le R_\\rho(x)\\le2/\\rho$ and a quadratic tail estimate.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-adaptive", target="_top"];
  "lem:product-tail" [label="Lemma 5.3\nProduct tail", tooltip="Bounds the tail of $\\rho R_\\rho(x)R_\\rho(y)$ by a quadratic decay times the smaller of two logarithmic factors, for $1\\le z\\le4/\\rho$; above this range the tail is empty on irrational-coordinate pairs.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-product-tail", target="_top"];
  "lem:distance-tail" [label="Lemma 5.4\nDistance tail", tooltip="For $X\\ge2$ and $t>0$, the measure of $\\{d_X>t\\}$ is $\\ll [1+\\min\\{\\log(2+Xt),\\log(2+1/(Xt^2))\\}]/(X^2t^2)$.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-distance-tail", target="_top"];
  "lem:empty" [label="Lemma 5.5\nEmpty rectangles", tooltip="Gives an explicit arithmetic inequality in the denominators of the rational corner and the side lengths that makes two oppositely oriented open rectangles empty of lifts of $\\mathcal P_X$.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-empty", target="_top"];
  "rem:negative" [label="Remark 5.6\nNegative distance moments", tooltip="For $X\\ge2$ and $-2<s<0$, the distance moment has order $X^{-s}$. For $s\\le-2$ it diverges. The three assertions use disc counting, the positive first-moment upper bound, and a local singularity, respectively.", shape="box", style="rounded,dashed,filled", fillcolor="#F1F5F9", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#rem-negative", target="_top"];
  "prop:long" [label="Proposition 6.1\nLong-interval remainder", tooltip="For integer $Q\\ge2$, $M\\in\\mathbb Z$ and integer $H\\ge1$, the second moment over $M<n\\le M+H$ differs from $HN_Q$ by at most $Q(Q-1)N_Q$.", shape="box", style="rounded,filled", fillcolor="#E0F2FE", color="#0284C7", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#prop-long", target="_top"];
  "lem:poisson" [label="Lemma 6.2\nPoisson weight identity", tooltip="For real $L\\ge2$, the absolutely convergent Fourier series of $w(n/L)$ equals the triangular kernel $L(1-L\\lVert\\theta\\rVert)_+$ for every real $\\theta$.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-poisson", target="_top"];
  "lem:exact" [label="Lemma 6.3\nExact weighted identity", tooltip="For integer $Q\\ge2$ and real $L\\ge Q^2/2$, evaluates the weighted second moment as the diagonal term $LN_Q$ plus the contribution of determinant-one Farey pairs. The correction vanishes for $L\\ge Q(Q-1)$.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-exact", target="_top"];
  "lem:positive" [label="Lemma 6.4\nPositivity of I(tau)", tooltip="For $1/2\\le\\tau<1$, reduces $I(\\tau)$ to a one-dimensional integral and proves it is positive. On $[1/2,5/8]$ it gives the explicit lower bound $1/9000$.", shape="box", style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", fontcolor="#172554", fontname="DejaVu Sans", fontsize="11", margin="0.14,0.10", penwidth="1.1", URL="https://github.com/nicolasrobles/modular_inverses_ii/blob/main/INVENTORY.md#lem-positive", target="_top"];
  "lem:adaptive" -> "lem:product-tail";
  "lem:annulus" -> "thm:height";
  "lem:annulus" -> "thm:short";
  "lem:distance-tail" -> "thm:distance";
  "lem:empty" -> "thm:distance";
  "lem:exact" -> "thm:correction";
  "lem:farey" -> "lem:adaptive";
  "lem:farey" -> "lem:farey-product";
  "lem:farey-product" -> "lem:distance-tail";
  "lem:ks" -> "lem:pair-pointwise";
  "lem:kuznetsov" -> "lem:window";
  "lem:low" -> "lem:twist";
  "lem:pair-pointwise" -> "thm:pair-height";
  "lem:poisson" -> "lem:exact";
  "lem:positive" -> "thm:correction";
  "lem:product-tail" -> "lem:distance-tail";
  "lem:selberg" -> "prop:two";
  "lem:sieve" -> "prop:long";
  "lem:transforms" -> "lem:twist";
  "lem:twist" -> "lem:annulus";
  "lem:weil" -> "lem:annulus";
  "lem:window" -> "lem:twist";
  "prop:long" -> "cor:obstruction";
  "prop:two" -> "rem:weighted-two";
  "prop:two" -> "thm:pair-height";
  "thm:correction" -> "cor:obstruction";
  "thm:distance" -> "rem:negative";
  "thm:height" -> "cor:most";
  "thm:height" -> "cor:weighted";
  "thm:height" -> "prop:two";
  "thm:pair-height" -> "cor:pair-height-most";
  "cor:weighted" -> "rem:weighted-two" [tooltip="Reuse the proof of Corollary 3.3, replacing its numerical input by Proposition 3.4.", style="dashed", color="#7C3AED", label="proof method"];
}
